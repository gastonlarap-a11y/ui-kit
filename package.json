{
  "name": "@galarap/ui",
  "version": "0.0.0",
  "description": "Accessible React component library built on Base UI and Tailwind CSS v4.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "tailwindcss",
    "base-ui",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Gaston Lara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonlarap-a11y/ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/gastonlarap-a11y/ui-kit/issues"
  },
  "homepage": "https://github.com/gastonlarap-a11y/ui-kit#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types && npm run build:css",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/compiled.entry.css -o dist/styles.css --minify && node scripts/copy-tokens.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack-check": "npm run build && publint --strict && attw --pack .",
    "check:tarball": "node scripts/check-tarball.mjs",
    "attw": "attw --pack .",
    "publint": "publint --strict",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-lock-version.mjs",
    "release": "changeset publish",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.0",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
