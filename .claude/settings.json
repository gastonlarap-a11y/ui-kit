{
  "enabledPlugins": {
    "ux@dev-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm run build-storybook)",
      "Bash(npm run storybook)",
      "Bash(npm run pack-check)",
      "Bash(npm run check:tarball)",
      "Bash(npm ci)",
      "Bash(npx vitest run:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(npm run release)",
      "Bash(npm run changeset:version)",
      "Bash(npx changeset publish:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | xargs -r \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write --ignore-unknown >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 180,
            "command": "bash \"$HOME/.claude/hooks/verify-turn.sh\" 'npm run typecheck' 'npm run lint' 'npm run format:check'"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": ["~/.npm"]
    },
    "excludedCommands": [
      "npm run test",
      "npm run test:watch",
      "npm run storybook"
    ]
  }
}
