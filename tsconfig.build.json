{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    /* Declaration maps would point at sources we deliberately do not publish
       (`files: ["dist"]`), so they would only produce broken go-to-definition. */
    "declarationMap": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
